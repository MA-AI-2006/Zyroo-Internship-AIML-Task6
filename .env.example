# Copy to .env and edit. NEVER commit the real .env file.
DOCFLOW_MAX_FILE_MB=10
DOCFLOW_MIN_CLASSIFY_CONF=0.45
DOCFLOW_MIN_EXTRACT_CONF=0.50
DOCFLOW_HIGH_AMOUNT=50000
# DOCFLOW_DATA_DIR=./data
# Protect the REST API (clients send it in the X-API-Key header). Leave blank to disable.
DOCFLOW_API_KEY=
# Optional external AI for the assistant. Leave blank to stay fully local.
ANTHROPIC_API_KEY=
# Windows only, if Tesseract is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
